  },
  {
    "topic": "structureAndProperties",
    "en": {
      "q": "<strong>Simple molecular</strong> - electrical conductivity?",
      "a": "<strong>Non-conductor</strong> (no delocalized electrons or mobile ions)"
    },
    "zhHant": {
      "q": "<strong>簡單分子</strong> — 導電性？",
      "a": "<strong>不導電</strong>（無離域電子或可移動離子）"
    }
  },
  {
    "topic": "structureAndProperties",
    "en": {
      "q": "Substances that conduct electricity <strong>without decomposition</strong>?",
      "a": "<strong>Metals</strong> and <strong>graphite</strong> (by delocalized electrons)"
    },
    "zhHant": {
      "q": "哪些物質導電而<strong>不分解</strong>？",
      "a": "<strong>金屬</strong>與<strong>石墨</strong>（靠離域電子）"
    }
  },
  {
    "topic": "structureAndProperties",
    "en": {
      "q": "Substances that conduct electricity <strong>with decomposition</strong> (electrolytes)?",
