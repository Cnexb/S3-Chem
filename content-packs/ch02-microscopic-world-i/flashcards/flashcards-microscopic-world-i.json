    "topic": "structureAndProperties",
    "en": {
      "q": "Define <strong>giant metallic structure</strong>.",
      "a": "Metal ions in a <strong>giant lattice</strong> surrounded by a <strong>sea of delocalized electrons</strong>"
    },
    "zhHant": {
      "q": "定義<strong>巨型金屬結構</strong>。",
      "a": "金屬離子形成<strong>巨型晶格</strong>，外圍有<strong>離域電子海</strong>"
    }
  },
  {
    "topic": "structureAndProperties",
    "en": {
      "q": "<strong>Giant metallic</strong> - electrical conductivity?",
      "a": "<strong>Good conductor</strong> (solid and liquid) due to <strong>delocalized electrons</strong>"
    },
    "zhHant": {
      "q": "<strong>巨型金屬</strong> — 導電性？",
      "a": "<strong>良好導體</strong>（固態及液態）— 有<strong>離域電子</strong>"
    }
  },
  {
    "topic": "structureAndProperties",
    "en": {
      "q": "<strong>Giant metallic</strong> - melting point?",
      "a": "<strong>High</strong> - strong metallic bonds"
    },
    "zhHant": {
      "q": "<strong>巨型金屬</strong> — 熔點？",
      "a": "<strong>高</strong> — 金屬鍵強"
    }
  },
  {
    "topic": "structureAndProperties",
    "en": {
      "q": "<strong>Giant ionic</strong> - conductivity in <strong>solid</strong> state?",
      "a": "<strong>Non-conductor</strong> - ions not mobile"
    },
    "zhHant": {
      "q": "<strong>巨型離子</strong> — <strong>固態</strong>導電性？",
      "a": "<strong>不導電</strong> — 離子不能移動"
    }
  },
  {
    "topic": "structureAndProperties",
    "en": {
      "q": "<strong>Giant ionic</strong> - conductivity in <strong>molten/aqueous</strong> state?",
      "a": "<strong>Conductor</strong> - <strong>mobile ions</strong>"
    },
    "zhHant": {
      "q": "<strong>巨型離子</strong> — <strong>熔融／水溶液</strong>導電性？",
      "a": "<strong>導電</strong> — 有<strong>可移動離子</strong>"
    }
  },
  {
    "topic": "structureAndProperties",
    "en": {
      "q": "<strong>Giant ionic</strong> - melting point?",
      "a": "<strong>High</strong> - strong ionic bonds"
    },
    "zhHant": {
      "q": "<strong>巨型離子</strong> — 熔點？",
      "a": "<strong>高</strong> — 離子鍵強"
    }
  },
  {
    "topic": "structureAndProperties",
    "en": {
      "q": "<strong>Giant covalent</strong> - typical electrical conductivity?",
      "a": "<strong>Non-conductor</strong> (except <strong>graphite</strong>)"
    },
    "zhHant": {
      "q": "<strong>巨型共價</strong> — 典型導電性？",
      "a": "<strong>不導電</strong>（<strong>石墨</strong>除外）"
    }
  },
  {
    "topic": "structureAndProperties",
    "en": {
      "q": "<strong>Giant covalent</strong> - melting point?",
      "a": "<strong>High</strong> - strong covalent bonds between atoms"
    },
    "zhHant": {
      "q": "<strong>巨型共價</strong> — 熔點？",
      "a": "<strong>高</strong> — 原子間共價鍵強"
    }
  },
  {
    "topic": "structureAndProperties",
    "en": {
      "q": "<strong>Simple molecular</strong> - melting point?",
